{
  "versions": ["1.2.0", "1.3.0"],
  "documents": [
    {
      "openapi": "3.1.1",
      "info": {
        "title": "Harbor Gauge Bulletin",
        "version": "1.2.0",
        "description": "Synthetic tide readings for one harbor gauge."
      },
      "paths": {
        "/gauges/{gauge_id}": {
          "get": {
            "operationId": "readGauge",
            "description": "Read the latest bulletin.",
            "responses": {
              "200": {
                "description": "A gauge reading",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["gauge_id", "height_mm"],
                      "properties": {
                        "gauge_id": {"type": "string"},
                        "height_mm": {"type": "integer"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "openapi": "3.1.1",
      "info": {
        "title": "Harbor Gauge Bulletin",
        "version": "1.3.0",
        "description": "Synthetic tide readings for one harbor gauge."
      },
      "paths": {
        "/gauges/{gauge_id}": {
          "get": {
            "operationId": "readGauge",
            "description": "Read the latest bulletin.",
            "responses": {
              "200": {
                "description": "A gauge reading",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["gauge_id", "height_mm"],
                      "properties": {
                        "gauge_id": {"type": "string"},
                        "height_mm": {"type": "integer"},
                        "spare_note": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
