  "notice": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "enum": ["send_notice"]},
      "case_id": {"type": "string", "const": "NOTE-14"},
      "user_id": {"type": "string", "const": "clerk.mina"},
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requisition_id": {"type": "string", "pattern": "^RQ-[0-9]{2}$"},
