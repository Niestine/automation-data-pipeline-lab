{
  "answer": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rationale": {"type": "string"},
      "answer": {"type": "string"}
    },
    "required": ["rationale", "answer"]
  },
  "answer_swapped": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "answer": {"type": "string"},
      "rationale": {"type": "string"}
    },
    "required": ["answer", "rationale"]
  },
  "classify": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rationale": {"type": "string"},
      "answer": {"type": "string", "enum": ["domestic", "foreign"]}
    },
    "required": ["rationale", "answer"]
  },
  "pair": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "code": {"type": "string", "enum": ["RQ-14", "RQ-22"]},
      "lane": {"type": "string", "enum": ["domestic", "foreign"]}
    },
    "required": ["code", "lane"]
  },
  "roles": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "roles": {"type": "array", "items": {"type": "string"}}
    },
    "required": ["roles"]
  },
  "format_answer": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "email": {"type": "string", "format": "email"},
      "answer": {"type": "string"}
    },
    "required": ["email", "answer"]
  },
  "hold": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "enum": ["place_hold"]},
      "case_id": {"type": "string", "const": "HOLD-14"},
      "user_id": {"type": "string", "const": "clerk.mina"},
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requisition_id": {"type": "string", "pattern": "^RQ-[0-9]{2}$"},
          "amount": {"type": "integer", "minimum": 1, "maximum": 5000},
          "currency": {"type": "string", "enum": ["JPY"]},
          "note": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "required": ["requisition_id", "amount", "currency", "note"]
      }
    },
    "required": ["tool", "case_id", "user_id", "arguments"]
  },
  "hold_rq22": {
    "type": "object",
